user parameters [
     # BOUNDARY CONDITIONS
     top_traction  = [ 0.0e+06 , -1e7 ] 
     bot_traction  = [ -0.0e+06 ,  1e7 ] 
     shear_velocity = 3e-1
     fss = 0.0
     is_traction_driven = false

     mesh = "ntn_test_ras.msh"
     spatial_dimension = 2
     output_folder = "test_x"

     nb_it_nodes = 100
     damping_mode = n
     output_prefix = NS
     noise_file = noise_field_200.dat
     pos_file = pos_field_200.dat
     perturbation_amplitude = 0.2
          
     # TIME
     nb_steps  = 1000
     dump_every = 10
     time_step_factor = 0.2
]

friction linear_slip_weakening_no_healing [
     mu_s = 0.3
     mu_k = 0.1
     d_c = 1e-6
]

material elastic [
     name = slider
     rho  = 3000
     nu   = 0.25
     E    = 27.74e9
     Plane_Stress = 1
]

material elastic [
     name = base
     rho  = 2500
     nu   = 0.25
     E    = 8e9
     Plane_Stress = 1
]
